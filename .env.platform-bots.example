# 独立平台 MCP 程序配置
# 访问令牌只由对应平台程序读取，不会写入 Sculk Cloud 任务。

# 抖音官方开放平台或经过授权的合规连接器
SCULK_DOUYIN_API_BASE=https://open.douyin.com
SCULK_DOUYIN_ACCESS_TOKEN=
SCULK_DOUYIN_LIST_PATH=/item/comment/list/
SCULK_DOUYIN_REPLY_PATH=/item/comment/reply/

# 抖音官方 OAuth（启动 sculk-douyin.exe --login 后在本机浏览器扫码）
SCULK_DOUYIN_CLIENT_KEY=
SCULK_DOUYIN_CLIENT_SECRET=
SCULK_DOUYIN_SCOPES=item.comment
SCULK_DOUYIN_LOGIN_PORT=18432
SCULK_DOUYIN_REDIRECT_URI=http://127.0.0.1:18432/oauth/callback

# B站：必须填写经过授权的官方/合规连接器地址和路径。
# 不要把网页 Cookie、未知第三方接口或私有接口当作生产配置。
SCULK_BILIBILI_API_BASE=
SCULK_BILIBILI_ACCESS_TOKEN=
SCULK_BILIBILI_LIST_PATH=
SCULK_BILIBILI_REPLY_PATH=

# B 站官方开放平台 OAuth；请填写平台审核通过的授权地址和 Token 地址
SCULK_BILIBILI_CLIENT_ID=
SCULK_BILIBILI_CLIENT_SECRET=
SCULK_BILIBILI_AUTH_URL=
SCULK_BILIBILI_TOKEN_URL=
SCULK_BILIBILI_SCOPES=
SCULK_BILIBILI_LOGIN_PORT=18433
SCULK_BILIBILI_REDIRECT_URI=http://127.0.0.1:18433/oauth/callback
