{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --mode cloud",
    "dev:website": "vite --mode website",
    "build": "vue-tsc -b && vite build",
    "build:cloud": "vue-tsc -b && vite build --mode cloud --outDir dist-cloud",
    "build:website": "vue-tsc -b && vite build --mode website --outDir dist-website",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
