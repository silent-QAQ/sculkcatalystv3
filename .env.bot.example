# QQ / NapCat OneBot 11 HTTP API
SCULK_NAPCAT_API_URL=http://127.0.0.1:3000
SCULK_NAPCAT_ACCESS_TOKEN=

# NapCat/视频平台桥接服务推送到 Sculk 的 Webhook 共享令牌（可选但建议设置）
SCULK_BOT_WEBHOOK_TOKEN=change-me

# 视频平台评论回复桥接服务（可选）
# 入站评论统一 POST 到 /api/bots/{adapter-id}/webhook；
# 出站桥接服务收到标准化 JSON 后负责调用平台官方/合规接口发表评论。
SCULK_BILIBILI_REPLY_URL=
SCULK_DOUYIN_REPLY_URL=
SCULK_VIDEO_REPLY_URL=

# 可选：自建通用搜索 JSON API；请求参数 q、limit，返回 items 或 results 数组
# 每项至少包含 title/name，可选 url/link
SCULK_WEB_SEARCH_API_URL=
