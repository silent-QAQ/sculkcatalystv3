# 开服器总站连接远程资源库时使用（配置在本机 Rust 后端）。
SCULK_RESOURCE_API_BASE=https://resources.example.com
# 与资源服务器反向代理约定的写接口 Bearer Token，请使用高熵随机值。
SCULK_RESOURCE_API_TOKEN=replace-with-a-long-random-resource-write-token
# 空闲扫描间隔，最小 30 秒；生产建议 300-1800 秒。
SCULK_RESOURCE_SYNC_INTERVAL_SECONDS=300
# 可选，提高总站读取 GitHub 源码树和原始文件时的速率额度。
GITHUB_TOKEN=
