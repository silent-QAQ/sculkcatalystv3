# 独立资源中心后端（在高带宽服务器上使用）
SCULK_BIND_ADDRESS=127.0.0.1:8789
SCULK_STATE_FILE=data/resource-center.json
SCULK_STATIC_DIR=../frontend/dist
SCULK_RESOURCE_OBJECT_DIR=D:/sculk-resource-objects
SCULK_RESOURCE_OBJECT_ROOT=D:/sculk-resource-objects
SCULK_RESOURCE_PUBLIC_BASE=https://resources.example.com
SCULK_RESOURCE_UPLOAD_MAX_BYTES=268435456

# MSL V4 核心镜像自动同步。生产资源站启用；总站后端保持关闭。
SCULK_MSL_CORE_SYNC_ENABLED=true
SCULK_MSL_API_BASE=https://api.mslmc.cn/v4
SCULK_FASTMIRROR_API_BASE=https://download.fastmirror.net
SCULK_POLARS_API_BASE=https://mirror.polars.cc
SCULK_MSL_TARGET_VERSIONS=1.12.2,1.16,1.18,1.20.1,1.20.4,1.21.1,1.21.11,26.1.2,26.2
SCULK_MSL_SYNC_INTERVAL_SECONDS=7200
SCULK_MSL_SYNC_CONCURRENCY=12
SCULK_MSL_REQUEST_INTERVAL_MS=750
SCULK_MSL_INSPECT_DOWNLOAD_METADATA=false
SCULK_MSL_USER_AGENT="Sculk-Catalyst-Resource-Sync/1.0 (+https://res.mcmy.love)"

# 允许访问资源 API 的主站来源。多个来源使用英文逗号分隔，不能包含路径。
SCULK_ALLOWED_ORIGINS=https://panel.example.com
# 写操作必须配置至少一种认证方式；公开占位值（replace-with-*、change-me、example*）会被后端拒绝。
# 自动化客户端使用高熵 Bearer Token；可与 SCULK_RESOURCE_API_TOKEN 使用同一个值。
SCULK_CATALOG_ADMIN_TOKEN=
# Caddy 使用此值验证自动化客户端；必须与上面的机器令牌及总站保持一致。
SCULK_RESOURCE_API_TOKEN=
# 浏览器管理页使用账号密码。密码只配置在服务端，不能写进前端构建变量。
SCULK_CATALOG_ADMIN_USERNAME=
SCULK_CATALOG_ADMIN_PASSWORD=
# 运行 printf '%s' '<账号>:<密码>' | base64 -w0 生成，仅供 Caddy 精确匹配 Basic 请求头。
SCULK_CATALOG_ADMIN_BASIC_AUTH=

# 主站前端构建变量（在主站构建 frontend 时设置，不是 Rust 后端变量）
VITE_RESOURCE_API_BASE=https://resources.example.com
