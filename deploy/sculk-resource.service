[Unit]
Description=Sculk independent resource catalog API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sculk-resource
Group=sculk-resource
WorkingDirectory=/opt/sculk-resource/current/backend
EnvironmentFile=/opt/sculk-resource/config/resource.env
ExecStart=/opt/sculk-resource/current/backend/target/release/backend
Restart=on-failure
RestartSec=3
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/sculk-resource/data /opt/sculk-resource/objects
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
