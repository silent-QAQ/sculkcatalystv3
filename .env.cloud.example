# 必填：分别设置为不同的高熵随机值。建议使用 URL 安全字符（A-Z、a-z、0-9、_、-）；否则 DATABASE_URL 和 REDIS_URL 中必须对密码进行 URL 编码。
SCULK_POSTGRES_PASSWORD=
SCULK_REDIS_PASSWORD=
DATABASE_URL=postgres://sculk:<set-to-SCULK_POSTGRES_PASSWORD>@127.0.0.1:5432/sculk_cloud
REDIS_URL=redis://:<set-to-SCULK_REDIS_PASSWORD>@127.0.0.1:6379/
# 必填：至少 24 个字符的高熵随机值。不要填写 replace-with-*、change-me 或 example*；
# 后端会拒绝这些公开占位值。它用于加密管理员配置的上游 API Key。
SCULK_MASTER_KEY=
SCULK_CLOUD_SESSION_DAYS=30
SCULK_CLOUD_RATE_LIMIT=60
SCULK_CLOUD_PUBLIC_URL=https://cloud.example.com
# 对外部署时改为 0.0.0.0:8787，并由 HTTPS 反向代理保护。
SCULK_BIND_ADDRESS=127.0.0.1:8787
# 与本地开发后端并行运行时使用独立状态文件，避免两个进程互相覆盖。
SCULK_STATE_FILE=data/state-cloud.json
# 多个静态前端来源使用英文逗号分隔，不要填写路径。
SCULK_ALLOWED_ORIGINS=
SCULK_STATIC_DIR=../frontend/dist
